node_modules/
.venv/
venv/
__pycache__/
dist/
build/
coverage/

# ===== 系统与编辑器 =====
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/

# ===== 原书与素材：体积大、有版权，不提交 =====
*.pdf
reference/

# ===== 可由脚本重新生成的产物 =====
work/
site/data/pages/

# ===== 音频文件：在单独的仓库 cet4-vocab-audio，本地克隆在这里 =====
audio-store/
